{
  "name": "bose-rc1",
  "version": "0.1.0",
  "private": true,
  "description": "BOSE RC1 - Business OS Engine for Telegram-first teams, with Furneq as the first live module.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "check:launch-config": "node scripts/check-launch-config.mjs",
    "check:system": "node scripts/check-system.mjs",
    "check:system:ready": "node scripts/check-system.mjs --require-ready",
    "check:rc": "npm run check:launch-config && npm run check:system:ready && npm run build && npm run validate:live-db",
    "bootstrap:live-db": "node scripts/bootstrap-live-db.mjs",
    "validate:live-db": "node scripts/validate-live-db.mjs",
    "telegram:poll-once": "node scripts/telegram-poll-once.mjs",
    "telegram:poll-loop": "node scripts/telegram-poll-loop.mjs",
    "telegram:webhook:info": "node scripts/telegram-webhook.mjs info",
    "telegram:webhook:set": "node scripts/telegram-webhook.mjs set",
    "telegram:webhook:delete": "node scripts/telegram-webhook.mjs delete",
    "telegram:me": "node scripts/telegram-webhook.mjs me",
    "telegram:commands:set": "node scripts/telegram-webhook.mjs commands",
    "cleanup:demo-state": "node scripts/cleanup-demo-state.mjs"
  },
  "dependencies": {
    "@vercel/blob": "^2.4.0",
    "next": "^15.3.2",
    "pg": "^8.13.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  }
}
