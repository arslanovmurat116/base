# BOSE RC1 core
DISET_DEFAULT_COMPANY_ID=11111111-1111-1111-1111-111111111111
# Use the canonical Vercel alias or local dev URL only.
APP_BASE_URL=http://localhost:3000
APP_VERSION=rc1

# Postgres
POSTGRES_HOST=replace_me
POSTGRES_PORT=5432
POSTGRES_DATABASE=replace_me
POSTGRES_USER=replace_me
POSTGRES_PASSWORD=replace_me
POSTGRES_SSL=false
POSTGRES_POOL_MAX=10
POSTGRES_IDLE_TIMEOUT_MS=30000
POSTGRES_CONNECT_TIMEOUT_MS=15000
POSTGRES_QUERY_TIMEOUT_MS=25000
POSTGRES_STATEMENT_TIMEOUT_MS=20000

# Telegram
TELEGRAM_BOT_TOKEN=replace_me_optional
TELEGRAM_BOT_SECRET_TOKEN=replace_me_optional
TELEGRAM_DIRECTOR_CHAT_IDS=replace_me_optional
TELEGRAM_MANAGER_CHAT_IDS=replace_me_optional
# Trusted private Telegram user IDs. Self-registration does not grant project access.
# Existing DIRECTOR/MANAGER chat IDs also grant edit access; MEASURER and PRODUCTION
# IDs grant read access; INSTALLER IDs can read projects and add photos only.
# Self-registration never grants access.
TELEGRAM_PROJECT_EDITOR_IDS=
TELEGRAM_PROJECT_VIEWER_IDS=
TELEGRAM_MEASURER_CHAT_IDS=replace_me_optional
TELEGRAM_DESIGNER_CHAT_IDS=
TELEGRAM_PRODUCTION_CHAT_IDS=
TELEGRAM_INSTALLER_CHAT_IDS=
CRON_SECRET=replace_me_optional

# Optional dedicated HMAC secret for BOSE's HttpOnly Mini App session cookie.
# If omitted, the Telegram bot token is used as the signing secret.
BOSE_AUTH_SECRET=replace_me_optional

# Storage
BLOB_READ_WRITE_TOKEN=replace_me_optional

# AI
OPENAI_API_KEY=replace_me_optional
OPENAI_MODEL=gpt-4.1-mini
